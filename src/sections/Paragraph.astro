<!-- Sección del párrafo -->
<section
  class="wrapper flex flex-col justify-center items-center h-auto md:h-[100vh] w-[80vw] mx-auto relative gap-20 mb-40"
>
  <!-- Texto principal en el centro -->
  <div class="mx-auto mb-0 md:mb-20">
    <p
      class="para text-white text-[5vh] md:text-[10vh] lg:text-[15vh] font-thin leading-tight opacity-0"
    >
      Los proyectos bien pensados merecen verse tan bien como funcionan.
    </p>
  </div>

  <!-- Footer en el margen inferior derecho -->
  <div
    class="foot flex justify-end items-center md:absolute md:bottom-4 md:right-4 mx-auto"
  >
    <p class="text-white text-[13px] md:text-[2vh] font-secondary text-end">
      * Diseños funcionales, accesibles y únicos para negocios que valoran la
      experiencia tanto como el resultado.
    </p>
  </div>
</section>

<section
  class="wrapper flex flex-col justify-center items-center h-auto md:h-[100vh] w-[80vw] md:w-[60vw] mx-auto relative gap-20 mb-0 sm:mb-40"
>
  <!-- Texto principal en el centro -->
  <div class="mx-auto mb-0 md:mb-20">
    <p
      class="para2 text-white text-[5vh] md:text-[10vh] lg:text-[15vh] font-thin leading-tight opacity-0"
    >
      Todo parte de una <span class="underline underline-offset-4 decoration-4"
        >marca sólida</span
      > que conecte
    </p>
  </div>

  <!-- Footer en el margen inferior derecho -->
  <div
    class="foot2 flex justify-end items-center md:absolute md:bottom-4 md:right-4 mx-auto"
  >
    <p class="text-white text-sm md:text-[2vh] font-secondary">
      En un entorno digital donde todo compite por atención, contar con una
      identidad clara y una presencia web bien construida no es opcional: es
      esencial. En Villa Ivan diseñamos marcas funcionales, accesibles y
      pensadas estratégicamente para que cada negocio pueda diferenciarse y
      crecer, más allá de su tamaño o rubro. Transformamos ideas en herramientas
      concretas que impulsan tu proyecto.
    </p>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const paragraph = document.querySelector(".para");
    const paragraph2 = document.querySelector(".para2");

    // Configuración de la animación de opacidad del párrafo
    gsap.fromTo(
      paragraph,
      { opacity: 0 },
      {
        opacity: 1,
        duration: 4,
        scrollTrigger: {
          trigger: paragraph,
          start: "top 90%", // La animación comienza cuando el top llega al 90% del viewport
          end: "+=300", // La animación finaliza cuando el desplazamiento es de 300px
          scrub: 3, // La animación se ajusta al desplazamiento de la página
        },
      }
    );
    gsap.fromTo(
      paragraph2,
      { opacity: 0 },
      {
        opacity: 1,
        duration: 4,
        scrollTrigger: {
          trigger: paragraph2,
          start: "top 90%", // La animación comienza cuando el top llega al 90% del viewport
          end: "+=300", // La animación finaliza cuando el desplazamiento es de 300px
          scrub: 3, // La animación se ajusta al desplazamiento de la página
        },
      }
    );
  });
</script>
